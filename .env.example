# REST API 기준 URL. 비워 두면 현재 origin과 Vite /api 프록시를 사용합니다.
VITE_API_BASE_URL=

# 채팅 WebSocket origin. 비워 두면 API URL에서 ws(s) 주소를 유도합니다.
VITE_WS_BASE_URL=

# 카카오 OAuth용 REST API 키 (MSW 로그인에서는 불필요)
VITE_KAKAO_REST_API_KEY=

# Kakao Maps JavaScript SDK 키
VITE_KAKAO_MAP_KEY=

# 브라우저 API 모킹 활성화: true | false
VITE_MSW_ENABLED=false
